{
    "name": "radar-empleo",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Buscador personal de vacantes remotas: junta ofertas de APIs públicas, las normaliza y (más adelante) las filtra y avisa por Telegram.",
    "scripts": {
        "start": "tsx --env-file-if-exists=.env src/index.ts",
        "dry": "tsx --env-file-if-exists=.env src/index.ts --dry-run",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "tsx": "^4.19.0",
        "typescript": "^5.6.0",
        "vitest": "^3.2.0"
    }
}
