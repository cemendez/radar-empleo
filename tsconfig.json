{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2024"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "skipLibCheck": true,
        "noEmit": true,
        "resolveJsonModule": true,
        "types": ["node"]
    },
    "include": ["src", "test"]
}
